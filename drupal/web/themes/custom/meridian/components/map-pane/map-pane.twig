<div{{ attributes.addClass('map-pane') }}>
    <svg class="map map--fill" viewBox="0 0 760 680" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Map of Meridian Airport: the terminals, rail station, car parks and approach roads">
    <rect class="map__ground" width="760" height="680"></rect>
    <path class="map__river" d="M0 0 H760 V120 C 640 150, 560 130, 470 160 C 390 185, 320 150, 240 170 C 160 190, 80 160, 0 190 Z"></path>
    <path class="map__green" d="M0 540 C 90 520, 150 560, 230 545 C 300 532, 330 575, 400 560 L 400 680 L 0 680 Z"></path>
    <rect class="map__green" x="560" y="420" width="200" height="140"></rect>
    <g class="map__block"><rect x="30" y="230" width="60" height="38"></rect><rect x="100" y="236" width="44" height="30"></rect><rect x="40" y="300" width="36" height="26"></rect><rect x="640" y="250" width="70" height="40"></rect><rect x="690" y="330" width="46" height="34"></rect><rect x="600" y="600" width="80" height="44"></rect><rect x="470" y="620" width="60" height="30"></rect></g>
    <path class="map__runway" d="M120 290 L 600 220" stroke-width="26"></path>
    <path class="map__dash" d="M120 290 L 600 220" stroke-width="3" stroke-dasharray="14 12"></path>
    <path class="map__road" d="M-20 660 C 120 600, 160 480, 300 470 C 420 462, 470 520, 560 500 C 640 482, 700 420, 790 410" stroke-width="22"></path>
    <path class="map__road-core" d="M-20 660 C 120 600, 160 480, 300 470 C 420 462, 470 520, 560 500 C 640 482, 700 420, 790 410" stroke-width="14"></path>
    <path class="map__road" d="M300 470 C 330 430, 360 400, 380 380" stroke-width="16"></path>
    <path class="map__lane" d="M300 470 C 330 430, 360 400, 380 380" stroke-width="10"></path>
    <path class="map__road" d="M380 380 C 420 350, 470 350, 520 372 C 560 390, 540 440, 500 436 C 460 432, 440 400, 470 390" stroke-width="16"></path>
    <path class="map__lane" d="M380 380 C 420 350, 470 350, 520 372 C 560 390, 540 440, 500 436 C 460 432, 440 400, 470 390" stroke-width="10"></path>
    <path class="map__road" d="M80 560 L 80 680 M 650 300 L 760 290 M 200 340 L 90 360" stroke-width="12"></path>
    <path class="map__lane" d="M80 560 L 80 680 M 650 300 L 760 290 M 200 340 L 90 360" stroke-width="7"></path>
    <path class="map__rail" d="M-20 420 C 100 420, 200 400, 330 400" stroke-width="4"></path>
    <path class="map__dash" d="M-20 420 C 100 420, 200 400, 330 400" stroke-width="2" stroke-dasharray="8 8"></path>
    <rect class="map__terminal" x="330" y="326" width="136" height="66" rx="6"></rect>
    <rect class="map__terminal map__terminal--alt" x="480" y="336" width="104" height="58" rx="6"></rect>
    <path class="map__link" d="M466 361 H480" stroke-width="10"></path>
    <text class="map__block-title" x="342" y="352" font-size="14">Terminal 1</text>
    <text class="map__block-sub" x="342" y="372" font-size="12">Rail station below</text>
    <text class="map__block-title" x="490" y="360" font-size="14">Terminal 2</text>
    <text class="map__block-sub" x="490" y="380" font-size="12">Gates 20–38</text>
    <g><rect class="map__chip" x="226" y="450" width="74" height="42" rx="5"></rect><text class="map__chip-title" x="234" y="468" font-size="13">P1</text><text class="map__chip-sub" x="234" y="484" font-size="12">2 min walk</text></g>
    <g><rect class="map__chip" x="306" y="450" width="74" height="42" rx="5"></rect><text class="map__chip-title" x="314" y="468" font-size="13">P2</text><text class="map__chip-sub" x="314" y="484" font-size="12">5 min walk</text></g>
    <g><rect class="map__chip" x="556" y="514" width="96" height="42" rx="5"></rect><text class="map__chip-title" x="564" y="532" font-size="13">Mid-Stay</text><text class="map__chip-sub" x="564" y="548" font-size="12">8 min shuttle</text></g>
    <circle class="map__station" cx="330" cy="400" r="7" stroke-width="3"></circle>
    <text class="map__station-label" x="342" y="416" font-size="12">Meridian Airport station</text>
    <g><rect class="map__a45" x="174" y="592" width="48" height="22" rx="3"></rect><text class="map__a45-text" x="184" y="608" font-size="12">A45</text></g>
    <g><rect class="map__a45" x="638" y="442" width="48" height="22" rx="3"></rect><text class="map__a45-text" x="648" y="458" font-size="12">A45</text></g>
    <text class="map__label map__label--river" x="40" y="100" font-size="14">River Meridian</text>
    <text class="map__label" x="586" y="586" font-size="12">Meridian Country Park</text>
    <text class="map__label" x="126" y="258" font-size="12">Marston End</text>
    <text class="map__label" x="636" y="270" font-size="12">Hollin Rise</text>
    <text class="map__label map__label--caps" x="452" y="250" font-size="12" letter-spacing="2">RUNWAY 09/27</text>
    <g transform="translate(395 300)"><path class="map__pin" d="M0 0 c-8 0 -14 -6 -14 -14 c0 -11 14 -24 14 -24 s14 13 14 24 c0 8 -6 14 -14 14z"></path><circle class="map__pin-dot" cx="0" cy="-14" r="5"></circle></g>
</svg>
    <div class="map-pane__card">
        <p class="map-pane__place"><span class="map-pane__name">{{ name }}</span><span class="map-pane__address">{{ address }}</span></p>
        <p class="map-pane__actions"><a class="button" href="{{ directions_href }}"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l9 9-9 9-9-9z"></path><path d="M9 12h6M13 10l2 2-2 2"></path></svg>Directions</a><a class="button button--secondary" href="{{ larger_href }}">Larger map</a></p>
    </div>
    <p class="map-pane__credit">Map data · <a class="map-pane__credit-link" href="/terms">Terms</a></p>
</div>
