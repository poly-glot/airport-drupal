<div{{ attributes.addClass('package') }}>
    {% if badge %}
    <p class="package__badge">{{ badge }}</p>
    {% endif %}
    <h3 class="package__tier">{{ tier }}</h3>
    <p class="package__price"><span class="package__unit">{{ price_prefix }}</span><span class="package__amount">{{ price }}</span><span class="package__unit">{{ unit }}</span></p>
    <p class="package__meta">{{ meta }}</p>
    <ul class="package__list">
        {% block features %}{% endblock %}
    </ul>
    <p class="package__best"><span class="package__best-label">{{ best_label }}</span>{{ note }}</p>
    <p class="package__cta"><a class="button{{ recommended ? '' : ' button--secondary' }} button--block" href="{{ href }}">{{ cta_label }}</a></p>
</div>
