<header{{ attributes.addClass('header') }}>
    <div class="header__inner container">
        <a class="header__brand" href="/"{% if brand_current %} aria-current="page"{% endif %}>
            <svg class="header__logo" width="34" height="34" viewBox="0 0 36 36" fill="none" aria-hidden="true"><circle cx="18" cy="18" r="16" stroke="currentColor" stroke-width="2.5"></circle><path d="M6 20c6-6 18-6 24 0" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path><path d="M18 4v12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path><circle cx="18" cy="18" r="2.5" fill="currentColor"></circle></svg>
            <span class="header__name">Meridian Airport</span><span class="visually-hidden"> home</span>
        </a>
        <nav class="header__nav" id="site-menu" aria-label="Main">
            <ul class="header__list">
                {% block nav %}{% endblock %}
            </ul>
        </nav>
        <div class="header__actions">
            <span class="header__lang"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18"></path></svg><span aria-hidden="true">EN</span><span class="visually-hidden">Language: English</span></span>
            <a class="icon-button" href="/sitemap" aria-label="Find a page on the site map"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg></a>
            <a class="icon-button" href="{{ basket_href }}" aria-label="{{ basket_label }}"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8h12l1 13H5z"></path><path d="M9 8V6a3 3 0 0 1 6 0v2"></path></svg></a>
            <a class="button header__cta" href="{{ cta_href }}">{{ cta_label }}</a>
            <a class="icon-button header__menu-toggle" href="#site-menu" aria-label="Open menu"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg></a>
        </div>
    </div>
</header>
