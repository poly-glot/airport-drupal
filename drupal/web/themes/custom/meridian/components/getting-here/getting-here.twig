{% set note_paths = {
    'step-free': '<circle cx="12" cy="4" r="2"></circle><path d="M10 8v6h6l3 6"></path><path d="M10 11h5"></path><path d="M6.5 13a5 5 0 1 0 7 6.5"></path>',
} %}
{% set heading_id = title_id|default('getting-here-title') %}
<section{{ attributes.addClass('getting-here') }}{% if anchor %} id="{{ anchor }}"{% endif %} aria-labelledby="{{ heading_id }}">
    <div class="getting-here__inner container">
        <div class="getting-here__copy">
            <h2 class="section-title section-title--md" id="{{ heading_id }}">{{ title }}</h2>
            <p class="getting-here__intro">{{ intro }}</p>
            <ul class="row-links">
                {% block rows %}{% endblock %}
            </ul>
            {% if note %}
            <p class="getting-here__note"><svg class="getting-here__note-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ note_paths[note_icon|default('step-free')]|raw }}</svg><span>{% if note_lead %}<strong class="getting-here__note-lead">{{ note_lead }}</strong> {% endif %}{{ note }}</span></p>
            {% endif %}
        </div>
    </div>
    {% block map %}{% endblock %}
</section>
