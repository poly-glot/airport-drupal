{%- import _self as srcsets -%}
{%- set width_in_stem = src|split('-')|last -%}
{%- set prefix = src|slice(0, src|length - width_in_stem|length) -%}
{%- set width_list = widths ? widths|split(',') : [width_in_stem] -%}
<picture{{ attributes.addClass(picture_class ? picture_class|split(' ')) }}>
{{- '' -}}
<source type="image/avif" srcset="{{ srcsets.build(prefix, width_list, 'avif') }}" sizes="{{ sizes|default('100vw') }}">
{{- '' -}}
<source type="image/webp" srcset="{{ srcsets.build(prefix, width_list, 'webp') }}" sizes="{{ sizes|default('100vw') }}">
{{- '' -}}
<img{% if css_class %} class="{{ css_class }}"{% endif %} src="{{ src }}.jpg" srcset="{{ srcsets.build(prefix, width_list, 'jpg') }}" sizes="{{ sizes|default('100vw') }}"{% if width %} width="{{ width }}"{% endif %}{% if height %} height="{{ height }}"{% endif %} alt="{{ alt|default('') }}" loading="{{ loading|default('lazy') }}"{% if priority %} fetchpriority="high"{% endif %} decoding="async">
{{- '' -}}
</picture>
{%- macro build(prefix, width_list, extension) -%}
{%- for width in width_list -%}
{{- prefix ~ width|trim ~ '.' ~ extension ~ ' ' ~ width|trim ~ 'w' -}}{{- loop.last ? '' : ', ' -}}
{%- endfor -%}
{%- endmacro -%}
