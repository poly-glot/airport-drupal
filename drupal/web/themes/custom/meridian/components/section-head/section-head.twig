<div{{ attributes.addClass('section-head') }}>
    {% if intro %}
    <div class="section-head__titles">
        <{{ heading_level|default('h2') }} class="section-title" id="{{ title_id }}">{{ title }}</{{ heading_level|default('h2') }}>
        <p class="section-head__intro">{{ intro }}</p>
    </div>
    {% else %}
    <{{ heading_level|default('h2') }} class="section-title" id="{{ title_id }}">{{ title }}</{{ heading_level|default('h2') }}>
    {% endif %}
    {% if link_label and link_href %}
    <a class="text-link" href="{{ link_href }}">{{ link_label }}<svg class="text-link__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
    {% endif %}
</div>
