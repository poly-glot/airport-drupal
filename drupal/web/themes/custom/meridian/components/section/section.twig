{% set tone = tone|default('light') %}
{% set heading_tag = heading_level|default('h2') %}
{% set root_tag = tag|default('section') %}
{% set labelled_id = labelled_by|default(heading|default(false) and anchor|default(false) ? anchor ~ '-title' : false) %}
<{{ root_tag }}{{ attributes.addClass('section', last|default(false) ? 'section--last', tone == 'panel' ? 'band--panel', 'container') }}{% if anchor|default(false) %} id="{{ anchor }}"{% endif %}{% if labelled_id %} aria-labelledby="{{ labelled_id }}"{% endif %}>
{% if heading|default(false) %}
<{{ heading_tag }} class="section-title section-title--sm"{% if anchor|default(false) %} id="{{ anchor }}-title"{% endif %}>{{ heading }}</{{ heading_tag }}>
{% endif %}
{% block parts %}{% endblock %}
</{{ root_tag }}>
