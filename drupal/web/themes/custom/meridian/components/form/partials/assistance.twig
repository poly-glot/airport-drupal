<form{{ attributes.addClass('card', 'card--padded', 'form', 'narrow') }} id="request" action="/help/special-assistance#request" method="get" aria-labelledby="request-title">
<div class="card__head">
<h2 class="card__title" id="request-title">Request assistance</h2>
</div>
<p class="form__note">This is a demonstration form for a fictional airport. Please do not enter real personal details. Nothing you type is sent anywhere.</p>
<div class="field"><label class="field__label" for="sa-name">Full name</label><p class="field__hint" id="sa-name-hint">As it appears on your booking</p><input class="field__input" id="sa-name" name="sa-name" type="text" autocomplete="name" aria-describedby="sa-name-hint" required></div>
<div class="field"><label class="field__label" for="sa-email">Email address</label><p class="field__hint" id="sa-email-hint">We send your confirmation here</p><input class="field__input" id="sa-email" name="sa-email" type="email" autocomplete="email" aria-describedby="sa-email-hint" required></div>
<div class="field"><label class="field__label" for="sa-phone">Phone number <span class="field__marker">(optional)</span></label><p class="field__hint" id="sa-phone-hint">So we can reach you on the day</p><input class="field__input" id="sa-phone" name="sa-phone" type="tel" autocomplete="tel" aria-describedby="sa-phone-hint"></div>
<div class="field"><label class="field__label" for="sa-flight">Flight number</label><p class="field__hint" id="sa-flight-hint">For example, MA 204</p><input class="field__input" id="sa-flight" name="sa-flight" type="text" aria-describedby="sa-flight-hint" required></div>
<div class="field"><label class="field__label" for="sa-date">Date of flight</label><p class="field__hint" id="sa-date-hint">Requests need at least 48 hours' notice</p><input class="field__input" id="sa-date" name="sa-date" type="date" aria-describedby="sa-date-hint" required></div>
<fieldset class="fieldset fieldset--inline" aria-describedby="sa-journey-hint">
<legend class="fieldset__legend">Help needed for</legend>
<p class="field__hint" id="sa-journey-hint">Choose one</p>
<label class="check"><input class="check__input" type="radio" name="sa-journey" value="departure" required>Departure</label><label class="check"><input class="check__input" type="radio" name="sa-journey" value="arrival" required>Arrival</label><label class="check"><input class="check__input" type="radio" name="sa-journey" value="both" required>Both</label>
</fieldset>
<fieldset class="fieldset" aria-describedby="sa-help-hint">
<legend class="fieldset__legend">What help would you like?</legend>
<p class="field__hint" id="sa-help-hint">Choose all that apply</p>
<label class="check"><input class="check__input" type="checkbox" name="sa-help-0" value="wheelchair-to-the-aircraft">Wheelchair to the aircraft</label><label class="check"><input class="check__input" type="checkbox" name="sa-help-1" value="help-walking-longer-distances">Help walking longer distances</label><label class="check"><input class="check__input" type="checkbox" name="sa-help-2" value="help-through-security">Help through security</label><label class="check"><input class="check__input" type="checkbox" name="sa-help-3" value="help-for-a-hidden-disability">Help for a hidden disability</label><label class="check"><input class="check__input" type="checkbox" name="sa-help-4" value="help-with-sight-loss">Help with sight loss</label><label class="check"><input class="check__input" type="checkbox" name="sa-help-5" value="help-with-hearing-loss">Help with hearing loss</label>
</fieldset>
<fieldset class="fieldset fieldset--inline">
<legend class="fieldset__legend">Are you bringing your own wheelchair or mobility aid?</legend>

<label class="check"><input class="check__input" type="radio" name="sa-wheelchair" value="yes" required>Yes</label><label class="check"><input class="check__input" type="radio" name="sa-wheelchair" value="no" required>No</label>
</fieldset>
<div class="field"><label class="field__label" for="sa-notes">Anything else we should know? <span class="field__marker">(optional)</span></label><p class="field__hint" id="sa-notes-hint">For example, an assistance dog or a medical device</p><textarea class="field__input field__input--multiline" id="sa-notes" name="sa-notes" rows="5" aria-describedby="sa-notes-hint"></textarea></div>
<div class="form__actions">
<button class="button button--lg" type="submit">Send request</button>
</div>
</form>
