{% if compact %}
<form{{ attributes.addClass('card', 'card--padded', 'form', 'photo-band__form', 'on-light') }} action="/parking#quote" method="get" aria-labelledby="book-parking-title">
    <div class="card__head">
        <h3 class="card__title" id="book-parking-title">Book parking</h3>
        <p class="card__text">Choose a car park, then your dates.</p>
    </div>
    <fieldset class="fieldset">
        <legend class="fieldset__legend">Car park</legend>
        <label class="choice"><input class="check__input" type="radio" name="carpark" value="p1"><span class="choice__text"><span class="choice__title">P1 Short-stay</span><span class="choice__meta">2 min walk · pick-up and drop-off</span></span><span class="choice__price">from £4 / hr</span></label>
        <label class="choice"><input class="check__input" type="radio" name="carpark" value="p2" checked><span class="choice__text"><span class="choice__title">P2 Long-stay</span><span class="choice__meta">5 min walk · covered</span></span><span class="choice__price">from £8.50 / day</span></label>
        <label class="choice"><input class="check__input" type="radio" name="carpark" value="mid-stay"><span class="choice__text"><span class="choice__title">Mid-Stay</span><span class="choice__meta">8 min shuttle · 10 min free wait</span></span><span class="choice__price">from £12 / day</span></label>
    </fieldset>
    <div class="field-grid form__rule">
        <div class="field"><label class="field__label field__label--caps" for="park-in">Arrive</label><input class="field__input" id="park-in" name="arrive" type="date"></div>
        <div class="field"><label class="field__label field__label--caps" for="park-out">Return</label><input class="field__input" id="park-out" name="return" type="date"></div>
    </div>
    <button class="button button--lg button--block" type="submit">Check prices and availability</button>
    <p class="form__small">No payment until you confirm. Free cancellation up to 24 hours before arrival.</p>
</form>
{% else %}
<form{{ attributes.addClass('card', 'card--padded', 'form', 'photo-band__form', 'on-light') }} id="quote" action="/parking#quote" method="get" aria-labelledby="quote-title">
<div class="card__head">
    <h2 class="card__title" id="quote-title">Book parking</h2>
    <p class="card__text">Choose a car park, then your dates.</p>
</div>
<p class="form__note">This is a demonstration form for a fictional airport. No booking is made and nothing is charged.</p>
<fieldset class="fieldset">
    <legend class="fieldset__legend">Car park <span class="field__marker">(required)</span></legend>
    <label class="choice"><input class="check__input" type="radio" name="carpark" value="p1" required><span class="choice__text"><span class="choice__title">P1 Short-stay</span><span class="choice__meta">2 min walk · pick-up and drop-off</span></span><span class="choice__price">from £4 / hr</span></label>
    <label class="choice"><input class="check__input" type="radio" name="carpark" value="p2" checked><span class="choice__text"><span class="choice__title">P2 Long-stay</span><span class="choice__meta">5 min walk · covered</span></span><span class="choice__price">from £8.50 / day</span></label>
    <label class="choice"><input class="check__input" type="radio" name="carpark" value="mid-stay"><span class="choice__text"><span class="choice__title">Mid-Stay</span><span class="choice__meta">8 min shuttle · 10 min free wait</span></span><span class="choice__price">from £12 / day</span></label>
</fieldset>
<div class="field-grid form__rule">
    <div class="field"><label class="field__label field__label--caps" for="arrive">Arrive</label><input class="field__input" id="arrive" name="arrive" type="date" required></div>
    <div class="field"><label class="field__label field__label--caps" for="return">Return</label><input class="field__input" id="return" name="return" type="date" required></div>
</div>
<div class="form__actions">
    <button class="button button--lg" type="submit">Check prices and availability</button>
</div>
<p class="form__small">No payment until you confirm. Free cancellation up to 24 hours before arrival.</p>
</form>
{% endif %}
