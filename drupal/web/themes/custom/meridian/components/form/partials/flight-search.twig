<form{{ attributes.addClass('search-card', 'on-light') }} action="/flights" method="get" aria-label="Flight tracking">
    <div class="search-card__tabs">
        <span class="search-card__tab search-card__tab--current">Flight tracking</span>
        <a class="search-card__tab" href="/at-the-airport/lounges">Fast Track</a>
        <a class="search-card__tab" href="/at-the-airport/lounges">Lounges</a>
    </div>
    <fieldset class="fieldset fieldset--inline">
        <legend class="visually-hidden">Direction</legend>
        <label class="check"><input class="check__input" type="radio" name="direction" value="departures" checked>Departures</label>
        <label class="check"><input class="check__input" type="radio" name="direction" value="arrivals">Arrivals</label>
    </fieldset>
    <div class="field">
        <label class="field__label" for="flight-day">When</label>
        <select class="field__input field__input--soft" id="flight-day" name="day"><option value="2026-10-03">Today, 3 October</option><option value="2026-10-04">Tomorrow, 4 October</option><option value="2026-10-05">Monday, 5 October</option></select>
    </div>
    <div class="field">
        <label class="field__label" for="flight-search">Flight number, airline or city</label>
        <div class="field__control">
            <svg class="field__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg>
            <input class="field__input field__input--soft field__input--with-icon" id="flight-search" name="q" type="search" placeholder="e.g. MA 204 or Lisbon">
        </div>
    </div>
    <button class="button button--lg search-card__submit" type="submit"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18M4 15l16-5-3-5-5 2-5-4-2 1 3 5-4 1-2-2-2 1z"></path></svg>Search flights</button>
    <a class="text-link text-link--sm" href="/flights#arrivals">Meeting someone? Go to live arrivals<svg class="text-link__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></a>
</form>
