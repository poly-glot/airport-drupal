<form{{ attributes.addClass('card', 'card--padded', 'form', 'narrow') }} id="set-up-alerts" action="/flights/alerts" method="get" aria-labelledby="set-up-alerts-title">
    <div class="card__head">
        <h2 class="card__title" id="set-up-alerts-title">Set up alerts</h2>
    </div>
    <p class="form__note">This is a demonstration form for a fictional airport. Please do not enter real personal details. Nothing you type is sent anywhere.</p>
    <div class="field">
        <label class="field__label" for="flight">Flight number <span class="field__marker">(required)</span></label>
        <p class="field__hint" id="flight-hint">For example, MA 204. It is on your booking confirmation.</p>
        <input class="field__input" id="flight" name="flight" type="text" autocomplete="off" aria-describedby="flight-hint" required>
    </div>
    <div class="field">
        <label class="field__label" for="flight-date">Date of flight <span class="field__marker">(required)</span></label>
        <input class="field__input" id="flight-date" name="date" type="date" required>
    </div>
    <fieldset class="fieldset fieldset--inline" aria-describedby="channel-hint">
        <legend class="fieldset__legend">How should we send alerts? <span class="field__marker">(required)</span></legend>
        <p class="field__hint" id="channel-hint">Choose one</p>
        <label class="check"><input class="check__input" type="radio" name="channel" value="text" required>Text message</label>
        <label class="check"><input class="check__input" type="radio" name="channel" value="whatsapp">WhatsApp</label>
    </fieldset>
    <div class="field">
        <label class="field__label" for="mobile">Mobile number <span class="field__marker">(required)</span></label>
        <p class="field__hint" id="mobile-hint">A UK or international number, starting with 0 or +</p>
        <input class="field__input" id="mobile" name="mobile" type="tel" autocomplete="tel" aria-describedby="mobile-hint" required>
    </div>
    <div class="field">
        <label class="field__label" for="email">Email address <span class="field__marker">(optional)</span></label>
        <p class="field__hint" id="email-hint">We send a copy of each alert here too</p>
        <input class="field__input" id="email" name="email" type="email" autocomplete="email" aria-describedby="email-hint">
    </div>
    <fieldset class="fieldset" aria-describedby="which-hint">
        <legend class="fieldset__legend">Which alerts do you want? <span class="field__marker">(required)</span></legend>
        <p class="field__hint" id="which-hint">Choose all that apply</p>
        <label class="check"><input class="check__input" type="checkbox" name="alert-gate" value="yes">Gate changes</label>
        <label class="check"><input class="check__input" type="checkbox" name="alert-delays" value="yes">Delays and cancellations</label>
        <label class="check"><input class="check__input" type="checkbox" name="alert-boarding" value="yes">Boarding calls</label>
        <label class="check"><input class="check__input" type="checkbox" name="alert-bags" value="yes">Bags on the belt (arrivals only)</label>
    </fieldset>
    <div class="field">
        <label class="check"><input class="check__input" type="checkbox" name="consent" value="yes" aria-describedby="consent-hint" required>I agree to receive alerts about this flight <span class="field__marker">(required)</span></label>
        <p class="field__hint" id="consent-hint">Alerts stop 2 hours after the flight lands or departs</p>
    </div>
    <div class="form__actions">
        <button class="button button--lg" type="submit">Sign up for alerts</button>
    </div>
</form>
