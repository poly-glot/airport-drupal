{%- set classes = overlapped ? ['board', 'board--overlapped', 'tabs', 'on-dark'] : ['board', 'tabs', 'on-dark'] -%}
<section{{ attributes.addClass(classes).setAttribute('id', 'live-flights').setAttribute('aria-labelledby', title_id) }}>
    <div class="board__head container">
        <div class="board__titles">
            <h2 class="board__title" id="{{ title_id }}">{{ title }}</h2>
            <p class="board__meta"><span class="board__dot"></span><span>Updated <span class="board__updated">{{ clock_time }}</span> · {{ meta }}</span></p>
        </div>
        <p class="board__clock"><span class="board__clock-time" data-flap="5">{{ clock_time }}</span><span class="board__clock-label">Local time</span></p>
    </div>
    <div class="board__tabbar">
        <div class="tabs__list container" data-tabs-label="Flight board">
            <a class="tabs__tab" href="#departures"><svg class="tabs__tab-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18M4 15l16-5-3-5-5 2-5-4-2 1 3 5-4 1-2-2-2 1z"></path></svg>Departures</a>
            <a class="tabs__tab" href="#arrivals"><svg class="tabs__tab-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18M4 11l16 5 1-5-5-2-3-6-2-1v6l-4-1-1-3-2 1z"></path></svg>Arrivals</a>
        </div>
    </div>
    <div>
            <div class="tabs__panel board__panel" id="departures" tabindex="-1">
                <div class="board__body container">
{% if show_search %}
                    <div class="board__search">
                        <label class="visually-hidden" for="departures-search">{{ departures_search_label }}</label>
                        <div class="field__control">
                            <svg class="field__icon board__search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg>
                            <input class="field__input field__input--with-icon field__input--dark" id="departures-search" type="search" placeholder="Search departures by flight or city" autocomplete="off">
                        </div>
                    </div>
{% endif %}
                    <section class="board__scroll" aria-label="Departures board" tabindex="0">
                        <table class="board__table">
                            <caption class="visually-hidden">{{ departures_caption }}</caption>
                            <thead>
                                <tr><th scope="col">Time</th><th scope="col">To</th><th scope="col">Flight</th><th scope="col">Terminal</th><th scope="col">Gate</th><th scope="col">Status</th><th scope="col">Info</th></tr>
                            </thead>
                            <tbody>
{% block departures %}{% endblock %}
                            </tbody>
                        </table>
                    </section>
                    <div class="board__foot">
                        <ul class="board__legend">
                            <li class="board__legend-item"><span class="board__swatch board__swatch--ok"></span>On time / landed</li>
                            <li class="board__legend-item"><span class="board__swatch board__swatch--info"></span>Boarding / gate open</li>
                            <li class="board__legend-item"><span class="board__swatch board__swatch--warn"></span>Delayed</li>
                            <li class="board__legend-item"><span class="board__swatch board__swatch--bad"></span>Cancelled</li>
                        </ul>
{% if all_departures_label %}
                        <a class="button button--ghost" href="{{ all_departures_href }}">{{ all_departures_label }}<svg class="text-link__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></a>
{% endif %}
                    </div>
                </div>
            </div>
            <div class="tabs__panel board__panel" id="arrivals" tabindex="-1">
                <div class="board__body container">
{% if show_search %}
                    <div class="board__search">
                        <label class="visually-hidden" for="arrivals-search">{{ arrivals_search_label }}</label>
                        <div class="field__control">
                            <svg class="field__icon board__search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg>
                            <input class="field__input field__input--with-icon field__input--dark" id="arrivals-search" type="search" placeholder="Search arrivals by flight or city" autocomplete="off">
                        </div>
                    </div>
{% endif %}
                    <section class="board__scroll" aria-label="Arrivals board" tabindex="0">
                        <table class="board__table">
                            <caption class="visually-hidden">{{ arrivals_caption }}</caption>
                            <thead>
                                <tr><th scope="col">Time</th><th scope="col">From</th><th scope="col">Flight</th><th scope="col">Terminal</th><th scope="col">Belt</th><th scope="col">Status</th><th scope="col">Info</th></tr>
                            </thead>
                            <tbody>
{% block arrivals %}{% endblock %}
                            </tbody>
                        </table>
                    </section>
                    <div class="board__foot">
                        <ul class="board__legend">
                            <li class="board__legend-item"><span class="board__swatch board__swatch--ok"></span>On time / landed</li>
                            <li class="board__legend-item"><span class="board__swatch board__swatch--info"></span>Boarding / gate open</li>
                            <li class="board__legend-item"><span class="board__swatch board__swatch--warn"></span>Delayed</li>
                            <li class="board__legend-item"><span class="board__swatch board__swatch--bad"></span>Cancelled</li>
                        </ul>
{% if all_arrivals_label %}
                        <a class="button button--ghost" href="{{ all_arrivals_href }}">{{ all_arrivals_label }}<svg class="text-link__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></a>
{% endif %}
                    </div>
                </div>
            </div>
    </div>
    <p class="visually-hidden" role="status" data-flap-announcer></p>
</section>
