{% set weather = default_weather|default('rainy') %}
{% set temperatures = { cloudy: '14°C', rainy: '12°C', sunny: '18°C' } %}
{% set conditions = { cloudy: 'cloudy', rainy: 'light rain', sunny: 'sunny' } %}
{% set temperature = temperatures[weather] %}
{% set condition = conditions[weather] %}
<section{{ attributes.addClass('hero', 'on-dark') }} aria-labelledby="hero-title" data-weather="{{ weather }}">
        <picture class="hero__media"><source type="image/avif" srcset="/assets/img/home/hero/morning-rainy-1440.avif 1440w" sizes="100vw"><source type="image/webp" srcset="/assets/img/home/hero/morning-rainy-1440.webp 1440w" sizes="100vw"><img class="hero__img" src="/assets/img/home/hero/morning-rainy-1440.jpg" srcset="/assets/img/home/hero/morning-rainy-1440.jpg 1440w" sizes="100vw" width="1440" height="810" alt="" loading="eager" fetchpriority="high" decoding="async"></picture>
        <div class="hero__inner container">
            <div class="hero__content">
                <p class="hero__weather{% if weather != 'rainy' %} hero__weather--dry{% endif %}"><svg class="hero__weather-icon hero__weather-icon--day" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8.5" cy="8" r="3.2"></circle><path d="M8.5 2v1.4M2.5 8h1.4M4.3 3.8l1 1M12.7 3.8l-1 1"></path><path d="M9 17.5h8.5a3 3 0 0 0 .4-6 4.5 4.5 0 0 0-8.6-1.3A3.6 3.6 0 0 0 9 17.5z"></path><path class="hero__weather-drops" d="M11 20l-.7 1.6M14.5 20l-.7 1.6M18 20l-.7 1.6"></path></svg><svg class="hero__weather-icon hero__weather-icon--evening" hidden width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 9.5a4 4 0 0 1 8 0"></path><path d="M2 9.5h13M8.5 3v1.4M3.8 5.3l1 1M13.2 5.3l-1 1"></path><path d="M9 17.5h8.5a3 3 0 0 0 .4-6 4.5 4.5 0 0 0-8.6-1.3A3.6 3.6 0 0 0 9 17.5z"></path><path class="hero__weather-drops" d="M11 20l-.7 1.6M14.5 20l-.7 1.6M18 20l-.7 1.6"></path></svg><svg class="hero__weather-icon hero__weather-icon--night" hidden width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.5 3.5a4.5 4.5 0 0 0 5.6 6 4.6 4.6 0 1 1-5.6-6z"></path><path d="M9 17.5h8.5a3 3 0 0 0 .4-6 4.5 4.5 0 0 0-8.6-1.3A3.6 3.6 0 0 0 9 17.5z"></path><path class="hero__weather-drops" d="M11 20l-.7 1.6M14.5 20l-.7 1.6M18 20l-.7 1.6"></path></svg><span class="hero__weather-text"><span class="hero__temp"><span class="hero__temp-value">{{ temperature }}</span> <span class="hero__condition">{{ condition }}</span></span><span class="hero__date">Saturday 3 October · 09:42 local</span></span></p>
                <h1 class="hero__title" id="hero-title">{{ title }}</h1>
                <p class="hero__lede">{{ intro }}</p>
                <ul class="hero__signs">
                    {% block signs %}{% endblock %}
                </ul>
            </div>
            {% block aside %}{% endblock %}
        </div>
        <div class="hero__wait container">
            {% block wait %}{% endblock %}
        </div>
</section>
