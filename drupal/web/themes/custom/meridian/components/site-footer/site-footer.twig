<footer{{ attributes.addClass('footer', 'on-dark') }}>
    <div class="footer__main container">
        <div class="footer__about">
            <p class="footer__brand"><svg class="footer__logo" width="28" height="28" viewBox="0 0 36 36" fill="none" aria-hidden="true"><circle cx="18" cy="18" r="16" stroke="currentColor" stroke-width="2.5"></circle><path d="M6 20c6-6 18-6 24 0" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path><path d="M18 4v12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path><circle cx="18" cy="18" r="2.5" fill="currentColor"></circle></svg><span class="footer__name">Meridian Airport</span></p>
            <p class="footer__contact">{{ enquiries }} <a class="footer__phone" href="{{ phone_href }}">{{ phone }}</a>{{ enquiries_suffix }}</p>
            <ul class="footer__social">
                <li><a class="footer__social-link" href="https://www.instagram.com/" aria-label="Instagram (external site)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor"></circle></svg></a></li>
                <li><a class="footer__social-link" href="https://x.com/" aria-label="X (external site)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 4l16 16M20 4L4 20"></path></svg></a></li>
                <li><a class="footer__social-link" href="https://www.youtube.com/" aria-label="YouTube (external site)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="3"></rect><path d="M10 9.5v5l4.5-2.5z" fill="currentColor"></path></svg></a></li>
                <li><a class="footer__social-link" href="https://www.linkedin.com/" aria-label="LinkedIn (external site)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 10v8M6 6h.01M10 18v-5a2.5 2.5 0 0 1 5 0v5M15 13a2.5 2.5 0 0 1 3 2.5V18"></path></svg></a></li>
            </ul>
        </div>
        <nav class="footer__col" aria-labelledby="footer-flights">
            <h2 class="footer__heading" id="footer-flights">Flights</h2>
            <ul class="footer__links">
                {% block col_flights %}{% endblock %}
            </ul>
        </nav>
        <nav class="footer__col" aria-labelledby="footer-shop">
            <h2 class="footer__heading" id="footer-shop">Shop &amp; relax</h2>
            <ul class="footer__links">
                {% block col_shop %}{% endblock %}
            </ul>
        </nav>
        <nav class="footer__col" aria-labelledby="footer-plan">
            <h2 class="footer__heading" id="footer-plan">Plan</h2>
            <ul class="footer__links">
                {% block col_plan %}{% endblock %}
            </ul>
        </nav>
        <nav class="footer__col" aria-labelledby="footer-company">
            <h2 class="footer__heading" id="footer-company">Company</h2>
            <ul class="footer__links">
                {% block col_company %}{% endblock %}
            </ul>
        </nav>
    </div>
    <div class="footer__legal">
        <div class="footer__legal-inner container">
            <p>{{ legal_line }}</p>
            <ul class="footer__legal-links">
                {% block legal %}{% endblock %}
            </ul>
        </div>
    </div>
</footer>
