{% set level = heading_level|default('h2') %}
{% set heading_id = title_id|default('photo-band-title') %}
<section{{ attributes.addClass('photo-band', variant == 'hero' ? 'photo-band--hero', 'on-dark') }}{% if anchor %} id="{{ anchor }}"{% endif %} aria-labelledby="{{ heading_id }}">
    {{ include('meridian:picture', { src: image_src, alt: image_alt|default(''), width: image_width, height: image_height, sizes: '100vw', loading: variant == 'hero' ? 'eager' : 'lazy', priority: variant == 'hero', picture_class: 'photo-band__media', css_class: 'photo-band__img' }, with_context = false) }}
    <div class="photo-band__inner container">
        <div class="photo-band__content">
            {% block breadcrumb %}{% endblock %}
            <{{ level }} class="section-title section-title--md photo-band__title" id="{{ heading_id }}">{{ title }}</{{ level }}>
            <p class="photo-band__lede">{{ intro }}</p>
            <dl class="stats">
                {% block facts %}{% endblock %}
            </dl>
            {% if link_label and link_href %}
            <a class="text-link text-link--underline text-link--on-dark" href="{{ link_href }}">{{ link_label }}<svg class="text-link__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></a>
            {% endif %}
        </div>
        {% block aside %}{% endblock %}
    </div>
</section>
