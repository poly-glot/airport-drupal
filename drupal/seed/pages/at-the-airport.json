  },
  {
   "uuid": "c213ebf5-dd08-4d32-a63a-ceda6cccc879",
   "component_id": "sdc.meridian.card",
   "parent_uuid": "a8bb95f7-aff9-41b4-933b-d4f94d65059b",
   "slot": "parts",
   "inputs": {
    "tag": "div",
    "heading": "Free wifi",
    "heading_level": "h3",
    "padded": true
   }
  },
  {
   "uuid": "11d953e1-2f55-47ff-9f95-19172b1f22be",
   "component_id": "sdc.meridian.paragraph",
   "parent_uuid": "c213ebf5-dd08-4d32-a63a-ceda6cccc879",
   "slot": "parts",
   "inputs": {
    "body": "Join \"Meridian Free Wifi\". No sign-up and no time limit.",
    "variant": "card-text"
   }
  },
  {
   "uuid": "69ad16a9-cf65-4f50-b138-e280d8d49d64",
   "component_id": "sdc.meridian.card",
   "parent_uuid": "a8bb95f7-aff9-41b4-933b-d4f94d65059b",
   "slot": "parts",
   "inputs": {
    "tag": "div",
    "heading": "Water and charging",
    "heading_level": "h3",
    "padded": true
   }
  },
  {
   "uuid": "c780bcd5-1f4b-4ff5-abce-f7eda1d916d8",
   "component_id": "sdc.meridian.paragraph",
   "parent_uuid": "69ad16a9-cf65-4f50-b138-e280d8d49d64",
   "slot": "parts",
   "inputs": {
    "body": "Free water refill points are after security, near every toilet block. Charging points are built into the seating at every gate.",
    "variant": "card-text"
   }
  },
  {
   "uuid": "4c767a75-5c4c-433d-bbfe-3ded2e1404fd",
   "component_id": "sdc.meridian.card",
   "parent_uuid": "a8bb95f7-aff9-41b4-933b-d4f94d65059b",
   "slot": "parts",
   "inputs": {
    "tag": "div",
    "heading": "Toilets and changing",
    "heading_level": "h3",
    "padded": true
   }
  },
  {
   "uuid": "389c5daf-f73b-4627-879e-05e76ab055d6",
   "component_id": "sdc.meridian.paragraph",
   "parent_uuid": "4c767a75-5c4c-433d-bbfe-3ded2e1404fd",
   "slot": "parts",
   "inputs": {
    "body": "Toilets are before and after security in both terminals. There are Changing Places toilets, with a hoist and adult-sized bench, in the departure lounge of each terminal, and baby changing in every toilet block.",
    "variant": "card-text"
   }
  },
  {
   "uuid": "d8be9256-fcb3-4cdb-a902-318382012d7b",
   "component_id": "sdc.meridian.card",
   "parent_uuid": "a8bb95f7-aff9-41b4-933b-d4f94d65059b",
   "slot": "parts",
   "inputs": {
    "tag": "div",
    "heading": "Prayer and quiet rooms",
    "heading_level": "h3",
    "padded": true
   }
  },
  {
   "uuid": "7023416f-2cfb-48cf-ab87-00416dc6f8d4",
   "component_id": "sdc.meridian.paragraph",
   "parent_uuid": "d8be9256-fcb3-4cdb-a902-318382012d7b",
   "slot": "parts",
   "inputs": {
    "body": "A multi-faith prayer room is open 24 hours after security in each terminal. Free Quiet Rooms are near gate 4 in Terminal 1 and gate 24 in Terminal 2.",
    "variant": "card-text"
   }
  },
  {
   "uuid": "424ae0d7-2918-4e49-bbee-9f552da132a6",
   "component_id": "sdc.meridian.card",
   "parent_uuid": "a8bb95f7-aff9-41b4-933b-d4f94d65059b",
   "slot": "parts",
   "inputs": {
    "tag": "div",
    "heading": "Money",
    "heading_level": "h3",
    "padded": true
   }
  },
  {
   "uuid": "815e4eef-3fe6-4f6d-a3e6-b39749b881bd",
   "component_id": "sdc.meridian.paragraph",
   "parent_uuid": "424ae0d7-2918-4e49-bbee-9f552da132a6",
   "slot": "parts",
   "inputs": {
    "body": "Cash machines are in both arrivals halls and departure lounges. You can change money at the currency desks after security in both terminals, and order currency online to collect on the day.",
    "variant": "card-text"
   }
  },
  {
   "uuid": "7f320220-f71f-4290-825b-7b8bea361f04",
   "component_id": "sdc.meridian.card",
   "parent_uuid": "a8bb95f7-aff9-41b4-933b-d4f94d65059b",
   "slot": "parts",
   "inputs": {
    "tag": "div",
    "heading": "Medical help",
    "heading_level": "h3",
    "padded": true
   }
  },
  {
   "uuid": "48e54414-fea9-4465-95ca-da207ba669fb",
   "component_id": "sdc.meridian.paragraph",
   "parent_uuid": "7f320220-f71f-4290-825b-7b8bea361f04",
   "slot": "parts",
   "inputs": {
    "body": "Speak to any member of staff, or call 0121 496 0123. First aid teams are on duty 24 hours. Fernhill Pharmacy, before security in Terminal 1, has a pharmacist on site from 05:00 to 21:00.",
    "variant": "card-text"
   }
  },
  {
   "uuid": "037d395f-c59f-4f3a-be75-5208d6969532",
   "component_id": "sdc.meridian.section",
   "inputs": {
