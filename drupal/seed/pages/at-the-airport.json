   "inputs": {
    "layout": "stack"
   }
  },
  {
   "uuid": "46260b46-5f12-4845-9699-5faa2c9335ab",
   "component_id": "sdc.meridian.heading",
   "parent_uuid": "fd05754f-7c54-487b-9911-ffe8d8714400",
   "slot": "parts",
   "inputs": {
    "text": "Need help on the day?",
    "level": "h2",
    "id": "need-help-on-the-day-title",
    "size": "sm"
   }
  },
  {
   "uuid": "0331d643-e44d-4890-a796-453d2fcfab21",
   "component_id": "sdc.meridian.prose",
   "parent_uuid": "fd05754f-7c54-487b-9911-ffe8d8714400",
   "slot": "parts",
   "inputs": {
    "body": "<p>Information desks are in both check-in halls and both departure lounges, open from the first flight to the last.</p>"
   }
  },
  {
   "uuid": "d164bf74-28dd-4d27-80fa-43cbddabf66c",
   "component_id": "sdc.meridian.paragraph",
   "parent_uuid": "fd05754f-7c54-487b-9911-ffe8d8714400",
