  {
   "uuid": "8109ebe7-96e9-46b4-a781-554f6be20c86",
   "component_id": "sdc.meridian.heading",
   "parent_uuid": "27f5b80c-d0e7-4594-9f10-957853273b99",
   "slot": "parts",
   "inputs": {
    "text": "Terminal maps",
    "level": "h2",
