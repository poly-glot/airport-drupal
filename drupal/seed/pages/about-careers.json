  },
  {
   "uuid": "f2c5198d-0ddf-4ac5-98fc-54cfdc24f27d",
   "component_id": "sdc.meridian.prose",
   "parent_uuid": "e91e8611-bbb0-4a59-a157-023fcccdfe10",
   "slot": "parts",
   "inputs": {
    "body": "<h2 id=\"adjustments-title\">Adjustments</h2>\n<p>Tell us if you need any adjustments to apply or to attend an interview. We will make them. We guarantee an interview to disabled applicants who meet the essential requirements.</p>"
   }
