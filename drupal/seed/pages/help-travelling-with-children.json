  {
   "uuid": "d3a98b80-3147-419d-8301-f074d55b279a",
   "component_id": "sdc.meridian.prose",
   "parent_uuid": "8dfb0405-7dc2-455c-bd1a-d1e093efbc02",
   "slot": "parts",
   "inputs": {
    "body": "<h2 id=\"need-a-hand-title\">Need a hand?</h2>\n<p>Ask at any information desk, or call <a href=\"tel:+441214960123\">0121 496 0123</a>, every day 05:00–23:00.</p>\n<p><a href=\"/help\">Help and contact</a></p>"
   }
  }
 ]
