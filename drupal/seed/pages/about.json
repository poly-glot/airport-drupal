  {
   "uuid": "43c4368f-fe78-4695-b2f4-bbfba38b8b68",
   "component_id": "sdc.meridian.testimonial",
   "parent_uuid": "3b44a0a3-49bf-408e-b9b7-457d2aa75fc8",
   "slot": "parts",
   "inputs": {
    "quote": "<p>Eight minutes through security with a pram, and the family lane staff talked to my daughter, not over her.</p>",
    "name": "Priya N.",
    "meta": "Flew to Lisbon, October 2026"
   }
  },
  {
   "uuid": "f3b9c1e4-636c-43af-80ae-73f30a1cefe9",
   "component_id": "sdc.meridian.testimonial",
   "parent_uuid": "3b44a0a3-49bf-408e-b9b7-457d2aa75fc8",
   "slot": "parts",
   "inputs": {
    "quote": "<p>The train drops you under the terminal. I left the office at five and was at the gate before six.</p>",
    "name": "Tom A.",
    "meta": "Flies to Amsterdam most months"
   }
  },
  {
   "uuid": "ccaafceb-858b-4931-9a3d-b28ba33ab145",
   "component_id": "sdc.meridian.testimonial",
   "parent_uuid": "3b44a0a3-49bf-408e-b9b7-457d2aa75fc8",
   "slot": "parts",
   "inputs": {
    "quote": "<p>I booked assistance the night before. Someone met me at the kerb and stayed until I was in my seat.</p>",
    "name": "Margaret O.",
    "meta": "Flew to Reykjavik, September 2026"
   }
  },
  {
   "uuid": "ad1dfd25-2a4d-42e3-af1e-64892e583dc8",
