  {
   "uuid": "ae59a7cf-b289-47d7-acd2-fce6e036987a",
   "component_id": "sdc.meridian.prose",
   "parent_uuid": "ad1dfd25-2a4d-42e3-af1e-64892e583dc8",
   "slot": "parts",
   "inputs": {
    "body": "<h2 id=\"our-neighbours-title\">Our neighbours</h2>\n<p>Around 40,000 people live within 5 kilometres of the runway. We run a noise insulation scheme for homes under the flight path, publish noise reports every month, and fund local projects through the Meridian Community Fund, which gave £420,000 to 63 groups in 2025.</p>"
   }
  },
