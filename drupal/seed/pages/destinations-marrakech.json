  {
   "uuid": "aee6a153-e63e-43a6-aef1-aaf932149237",
   "component_id": "sdc.meridian.heading",
   "parent_uuid": "c597ad87-6eee-4700-8b99-da16cfd991df",
   "slot": "parts",
   "inputs": {
    "text": "Practical tips",
    "level": "h2",
    "id": "practical-tips-title",
    "size": "sm"
   }
  },
  {
   "uuid": "f3ebfc8f-722e-4ef8-a90e-62ae0163bf91",
   "component_id": "sdc.meridian.prose",
   "parent_uuid": "c597ad87-6eee-4700-8b99-da16cfd991df",
   "slot": "parts",
   "inputs": {
    "body": "<ul><li><strong>Money.</strong> You cannot buy Moroccan dirhams in the UK. Take out cash at a machine in the arrivals hall, or change pounds there.</li><li><strong>Dress.</strong> Cover shoulders and knees in the medina, out of respect and for the sun.</li><li><strong>Taxis.</strong> Agree the fare before you get in, or ask the driver to use the meter.</li><li><strong>Weather.</strong> October is warm, around 27°C by day, and cool at night.</li></ul>\n<p><a href=\"/flights\">Check Marrakech flights</a></p>\n<p><a href=\"/flights/alerts\">Set up flight alerts</a></p>"
   }
  }
