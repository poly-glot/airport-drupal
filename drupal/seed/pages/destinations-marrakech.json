  {
   "uuid": "e3ed8d2a-7c2d-4439-b4b3-b568c0861f64",
   "component_id": "sdc.meridian.heading",
   "parent_uuid": "fe235587-b387-499e-b205-af5c2a933ee0",
   "slot": "parts",
   "inputs": {
    "text": "Eat",
    "level": "h2",
    "id": "eat-title",
    "size": "sm"
   }
  },
  {
   "uuid": "b37a14e2-86d6-4708-89de-ce98db903fff",
   "component_id": "sdc.meridian.prose",
   "parent_uuid": "fe235587-b387-499e-b205-af5c2a933ee0",
   "slot": "parts",
   "inputs": {
    "body": "<ul><li><strong>Tagine.</strong> Slow-cooked stew of meat or vegetables, often with preserved lemon, olives or prunes.</li><li><strong>Couscous.</strong> Traditionally eaten on Fridays, piled high with vegetables.</li><li><strong>Mint tea.</strong> Sweet, poured from a height, and offered almost everywhere as a welcome.</li><li><strong>The square at night.</strong> As the sun goes down, food stalls fill the main square. Choose a busy one where food is cooked in front of you.</li></ul>"
   }
  },
