  {
   "uuid": "e6b921b2-c8c1-4b10-b3c9-1cbd2745da71",
   "component_id": "sdc.meridian.heading",
   "parent_uuid": "86fffd46-1bcb-4f59-a0c1-939021030cc2",
   "slot": "parts",
   "inputs": {
    "text": "Where to stay",
    "level": "h2",
    "id": "where-to-stay-title",
    "size": "sm"
   }
  },
  {
   "uuid": "cd0da25d-56ef-46b9-b254-5ca01a131079",
   "component_id": "sdc.meridian.prose",
   "parent_uuid": "86fffd46-1bcb-4f59-a0c1-939021030cc2",
   "slot": "parts",
   "inputs": {
    "body": "<p>A riad is a traditional house built around a courtyard, often with only a handful of rooms. From the street you see a plain wall and a small door. Inside it is quiet, cool and green. Staying in one, inside the medina, puts you within walking distance of everything.</p>"
   }
  },
  {
