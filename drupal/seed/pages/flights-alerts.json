   "parent_uuid": "2e40edb1-9add-44c7-ab09-b8909d9c7186",
   "slot": "parts",
   "inputs": {
    "body": "<ol>\n<li>Enter your flight number and date.</li>\n<li>Choose text message or WhatsApp, and the alerts you want.</li>\n<li>We send a short test message to confirm.</li>\n<li>You get an alert each time something changes, until 2 hours after your flight leaves or lands.</li>\n</ol>\n<p>Alerts are free. We only use your number for alerts about the flight you choose, and we delete it 2 hours after the flight.</p>"
   }
