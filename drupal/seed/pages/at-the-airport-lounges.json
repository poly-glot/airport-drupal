   }
  },
  {
   "uuid": "0733ac8f-c562-4e6d-8446-3c79607915a6",
   "component_id": "sdc.meridian.heading",
   "parent_uuid": "e1ab20bf-7465-431a-90d1-7222e7b2c0bc",
   "slot": "parts",
   "inputs": {
    "text": "Work desks",
    "level": "h2",
    "id": "work-desks-title",
    "size": "sm"
   }
  },
  {
   "uuid": "4c9d44a2-eb4f-4f6f-8352-3fa9d824065d",
   "component_id": "sdc.meridian.prose",
   "parent_uuid": "e1ab20bf-7465-431a-90d1-7222e7b2c0bc",
   "slot": "parts",
   "inputs": {
    "body": "<p>Desks in both lounges have a power socket, a USB charger and a reading lamp. They are free with lounge entry. Without lounge entry, you can book a desk for £6 an hour.</p>"
   }
  },
  {
   "uuid": "5a1030c9-1989-4980-9e4e-178da48d9abf",
   "component_id": "sdc.meridian.section",
   "inputs": {
    "tone": "light",
    "tag": "section",
    "labelled_by": "quiet-rooms-title",
    "heading_level": "h2"
   }
  },
  {
   "uuid": "fda2ac85-f521-4ea3-9beb-516d506d3fd1",
   "component_id": "sdc.meridian.group",
   "parent_uuid": "5a1030c9-1989-4980-9e4e-178da48d9abf",
   "slot": "parts",
   "inputs": {
    "layout": "stack"
   }
  },
  {
   "uuid": "302c192b-7523-46dd-aec5-b278a74f034a",
   "component_id": "sdc.meridian.heading",
   "parent_uuid": "fda2ac85-f521-4ea3-9beb-516d506d3fd1",
   "slot": "parts",
   "inputs": {
    "text": "Quiet Rooms",
    "level": "h2",
    "id": "quiet-rooms-title",
    "size": "sm"
   }
  },
  {
   "uuid": "7b1ad2ba-9c0e-47b2-b13b-447cd1b0932f",
   "component_id": "sdc.meridian.prose",
   "parent_uuid": "fda2ac85-f521-4ea3-9beb-516d506d3fd1",
   "slot": "parts",
   "inputs": {
    "body": "<p>Free to everyone after security, open 24 hours. Low lights, comfortable seating and no announcements. Find them near gate 4 in Terminal 1 and gate 24 in Terminal 2. Please keep phone calls outside.</p>"
   }
  },
  {
   "uuid": "bb1bea70-16d3-47fb-a117-32f53d504f1d",
   "component_id": "sdc.meridian.section",
   "inputs": {
    "tone": "light",
    "tag": "section",
    "labelled_by": "prayer-rooms-title",
    "heading_level": "h2"
   }
  },
  {
   "uuid": "5a2fc03c-19af-4704-97f6-2a10203c0e05",
   "component_id": "sdc.meridian.group",
   "parent_uuid": "bb1bea70-16d3-47fb-a117-32f53d504f1d",
   "slot": "parts",
   "inputs": {
    "layout": "stack"
   }
  },
  {
   "uuid": "138822b0-7f53-46a1-8baf-1b1af82ed766",
   "component_id": "sdc.meridian.heading",
   "parent_uuid": "5a2fc03c-19af-4704-97f6-2a10203c0e05",
   "slot": "parts",
   "inputs": {
    "text": "Prayer rooms",
    "level": "h2",
    "id": "prayer-rooms-title",
    "size": "sm"
   }
  },
  {
   "uuid": "7ca9b78f-9da6-4322-b407-d589ffc76d59",
   "component_id": "sdc.meridian.prose",
   "parent_uuid": "5a2fc03c-19af-4704-97f6-2a10203c0e05",
   "slot": "parts",
   "inputs": {
    "body": "<p>A multi-faith prayer room is open 24 hours after security in each terminal, with washing facilities next door.</p>"
   }
  },
  {
   "uuid": "db7a95aa-a754-4300-aab4-eb444e77c15a",
   "component_id": "sdc.meridian.section",
   "inputs": {
    "last": true,
    "tone": "light",
