  },
  {
   "uuid": "5678e2c2-05a0-42e7-ba0d-00006e224e22",
   "component_id": "sdc.meridian.heading",
   "parent_uuid": "9ac2b18f-e9cf-455d-aac9-91c496d08de7",
   "slot": "parts",
   "inputs": {
    "text": "Fast Track",
    "level": "h2",
    "id": "fast-track-title",
    "size": "sm"
   }
  },
  {
   "uuid": "73a54eeb-548f-40ca-8dbb-5569df81a5db",
   "component_id": "sdc.meridian.prose",
   "parent_uuid": "9ac2b18f-e9cf-455d-aac9-91c496d08de7",
   "slot": "parts",
   "inputs": {
    "body": "<p>Skip the main security queue. Fast Track has its own lane in both terminals and costs £7 per person when booked at least 24 hours ahead, or £8 at the entrance on the day. Book it on its own or with a lounge.</p>\n<p><a href=\"/at-the-airport/security\">How security works</a></p>\n<p><button class=\"button button--secondary\" type=\"button\" disabled=\"\">Book Fast Track<span class=\"visually-hidden\"> (not available in this demonstration)</span></button></p>"
   }
  },
  {
   "uuid": "6ab8b3bf-b28d-4afe-a6ba-dfbfbfd52494",
   "component_id": "sdc.meridian.section",
   "inputs": {
    "tone": "light",
    "tag": "section",
    "labelled_by": "showers-title",
    "heading_level": "h2"
   }
  },
  {
   "uuid": "b84e04d9-4db2-4cf5-84f0-cda7d2474ff0",
   "component_id": "sdc.meridian.group",
   "parent_uuid": "6ab8b3bf-b28d-4afe-a6ba-dfbfbfd52494",
   "slot": "parts",
   "inputs": {
    "layout": "stack"
   }
  },
  {
   "uuid": "46e4f128-6fc6-4996-a59f-7f5648fd37cf",
   "component_id": "sdc.meridian.heading",
   "parent_uuid": "b84e04d9-4db2-4cf5-84f0-cda7d2474ff0",
   "slot": "parts",
   "inputs": {
    "text": "Showers",
    "level": "h2",
    "id": "showers-title",
    "size": "sm"
   }
  },
  {
   "uuid": "9a642592-e150-4935-934c-6cac8931830f",
   "component_id": "sdc.meridian.prose",
   "parent_uuid": "b84e04d9-4db2-4cf5-84f0-cda7d2474ff0",
   "slot": "parts",
   "inputs": {
    "body": "<p>Shower rooms are inside both lounges and you do not need a lounge booking to use one. A 30-minute slot costs £15 and includes towels, soap, shampoo and a hairdryer. One shower room in each lounge is step-free with a fold-down seat.</p>"
   }
  },
  {
   "uuid": "cb28e921-7afc-440c-86ca-7b3195658149",
   "component_id": "sdc.meridian.section",
   "inputs": {
    "tone": "light",
    "tag": "section",
    "labelled_by": "work-desks-title",
    "heading_level": "h2"
   }
  },
