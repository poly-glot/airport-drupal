   "component_id": "sdc.meridian.group",
   "parent_uuid": "db7a95aa-a754-4300-aab4-eb444e77c15a",
   "slot": "parts",
   "inputs": {
    "layout": "stack"
   }
  },
  {
   "uuid": "b48664fe-7714-44f2-b3c7-ca334f0c8752",
   "component_id": "sdc.meridian.heading",
   "parent_uuid": "207d6a42-0a51-4332-9ffe-b2995314d995",
   "slot": "parts",
   "inputs": {
    "text": "Overnight",
    "level": "h2",
    "id": "overnight-title",
    "size": "sm"
   }
  },
  {
   "uuid": "264dbd5d-7f98-4d65-be74-e28881e0b1a9",
   "component_id": "sdc.meridian.prose",
   "parent_uuid": "207d6a42-0a51-4332-9ffe-b2995314d995",
   "slot": "parts",
   "inputs": {
    "body": "<p>The terminals stay open 24 hours. If you have an early flight, you can wait in the check-in hall overnight. Security opens at 03:30. There are no beds in the terminals, but the Quiet Rooms are open all night.</p>\n<p><button class=\"button button--secondary\" type=\"button\" disabled=\"\">Book a lounge<span class=\"visually-hidden\"> (not available in this demonstration)</span></button></p>"
   }
  }
 ]
