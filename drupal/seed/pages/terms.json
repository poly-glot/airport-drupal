   "parent_uuid": "3c60bb30-67b6-4050-b6dc-303bb0ab4913",
   "slot": "parts",
   "inputs": {
    "body": "<h2 id=\"about-this-website-title\">About this website</h2>\n<p>This website is a demonstration. It is run by Meridian Airport Ltd, a fictional company, at Meridian Airport, Skyline Way, Birmingham B99 1MA. By using the site, you agree to these terms.</p>"
   }
  },
  {
   "uuid": "ad568cfd-ed84-4adc-b3b4-494a01d84d77",
   "component_id": "sdc.meridian.section",
   "inputs": {
    "anchor": "nothing-here-is-real",
    "tone": "light",
    "tag": "section",
    "labelled_by": "nothing-here-is-real-title",
    "heading_level": "h2"
   }
  },
  {
   "uuid": "354867d4-2f28-4099-b83e-46a09c64b496",
   "component_id": "sdc.meridian.prose",
   "parent_uuid": "ad568cfd-ed84-4adc-b3b4-494a01d84d77",
   "slot": "parts",
   "inputs": {
    "body": "<h2 id=\"nothing-here-is-real-title\">Nothing here is real</h2>\n<ul><li>There are no real flights, airlines, car parks, shops, restaurants, lounges or jobs on this site.</li><li>You cannot book, buy or reserve anything. Prices are examples only.</li><li>Forms do not send what you type. Do not enter real personal details.</li><li>Do not use this site to plan a real journey.</li></ul>"
   }
  },
  {
