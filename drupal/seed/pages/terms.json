   "slot": "parts",
   "inputs": {
    "body": "<h2 id=\"using-our-content-title\">Using our content</h2>\n<p>Text, illustrations and photographs on this site belong to Meridian Airport Ltd or are used with permission. You may view and print pages for your own use. You may not copy them for commercial use without asking us first.</p>"
   }
