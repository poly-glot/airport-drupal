  {
   "uuid": "cf3d2e74-8efd-4670-b309-f2b0cf0fcf20",
   "component_id": "sdc.meridian.prose",
   "parent_uuid": "1c418693-ce5f-4738-9e8d-8910ad5a2a54",
   "slot": "parts",
   "inputs": {
    "body": "<h2 id=\"accuracy-title\">Accuracy</h2>\n<p>The flight board, wait times, weather and travel notices are made-up examples. The board's changes are scripted and do not show real flights. Destination guides mention real cities and describe them in good faith, but entry rules, prices and opening times change. Always check official sources before you travel.</p>"
   }
  },
