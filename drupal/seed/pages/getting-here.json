  {
   "uuid": "51c6c6d1-4536-43f4-bbf7-bf72610748e5",
   "component_id": "sdc.meridian.prose",
   "parent_uuid": "9e21bb3f-682f-4baa-934f-20ea1aa32f0f",
   "slot": "parts",
   "inputs": {
    "body": "<p>Meridian Airport station is directly below Terminal 1. Trains run from Birmingham Central every 10 minutes, from 04:30 until midnight, and take 18 minutes.</p>\n<h3>From the platform to your terminal</h3>\n<ul>\n<li>For Terminal 1, take the lifts or escalators up one level. You arrive next to check-in zone A.</li>\n<li>For Terminal 2, go up to Terminal 1 and follow signs for the covered walkway. It is a 5-minute walk, step-free all the way.</li>\n</ul>\n<h3>Tickets</h3>\n<p>Buy your ticket before you board, from the station machines or online. Ask for \"Meridian Airport\" as your destination. Station staff are on hand from the first train to the last, and can arrange help for anyone who needs it.</p>"
   }
  },
  {
