  {
   "uuid": "251f5291-61cd-4f99-aacc-011c91a4beb6",
   "component_id": "sdc.meridian.heading",
   "parent_uuid": "752ea51a-51a8-4efc-9f19-e4b4f018a023",
   "slot": "parts",
   "inputs": {
    "text": "Order ahead",
    "level": "h2",
    "id": "order-ahead-title",
    "size": "sm"
   }
  },
  {
   "uuid": "c1d1cd63-e231-4657-a60a-cef996d34b14",
   "component_id": "sdc.meridian.prose",
   "parent_uuid": "752ea51a-51a8-4efc-9f19-e4b4f018a023",
   "slot": "parts",
   "inputs": {
    "body": "<p>Order from any venue after security in the Meridian Airport app, up to 2 hours before your flight. Pay in the app, and your food or coffee is waiting on the Order ahead shelf by the time you are through security.</p>"
   }
  },
  {
   "uuid": "f76af84b-f59d-41f8-974b-f19eaec40482",
