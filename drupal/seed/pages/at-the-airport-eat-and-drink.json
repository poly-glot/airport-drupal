    "size": "sm"
   }
  },
  {
   "uuid": "30ab6391-b3aa-4b24-ab1e-cbf4411054c9",
   "component_id": "sdc.meridian.prose",
   "parent_uuid": "df67d05b-d2e6-4abf-9cbb-0b1239e28978",
   "slot": "parts",
   "inputs": {
    "body": "<p>Most places open by 04:30 for the first flights. After security, venues stay open until the last departure or the time shown. Every venue has gluten-free and vegan choices, and staff can tell you about allergens.</p>"
   }
  },
