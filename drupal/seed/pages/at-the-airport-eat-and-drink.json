  {
   "uuid": "963d119d-8eea-4dbc-98e4-abd870ef3ad4",
   "component_id": "sdc.meridian.prose",
   "parent_uuid": "a3706de4-8d2b-4b99-b2a0-a0aed65844d8",
   "slot": "parts",
   "inputs": {
    "body": "<h3>Before security</h3>"
   }
  },
  {
   "uuid": "c7c0de05-e86e-413d-8e6c-3b72434043f3",
   "component_id": "sdc.meridian.data-table",
   "parent_uuid": "a3706de4-8d2b-4b99-b2a0-a0aed65844d8",
   "slot": "parts",
   "inputs": {
    "caption": "Terminal 1, before security",
    "caption_hidden": true,
    "body": "<thead><tr><th scope=\"col\">Venue</th><th scope=\"col\">Open</th><th scope=\"col\">What it serves</th></tr></thead>\n<tbody>\n<tr><th scope=\"row\">The Copper Kettle</th><td>04:00–22:00</td><td>Tea, coffee and bacon rolls by the arrivals doors. A good place to meet people off a flight.</td></tr>\n<tr><th scope=\"row\">Platform Seven Bakery</th><td>05:00–20:00</td><td>Fresh bread, pastries and sandwiches at the top of the station escalators.</td></tr>\n</tbody>"
   }
  },
  {
   "uuid": "814a4b85-8463-4902-a222-0f5e39de904a",
   "component_id": "sdc.meridian.prose",
   "parent_uuid": "a3706de4-8d2b-4b99-b2a0-a0aed65844d8",
   "slot": "parts",
   "inputs": {
    "body": "<h3>After security</h3>"
   }
  },
  {
   "uuid": "b5d092ea-6e8a-4a6e-bf1d-0f61a4546fea",
   "component_id": "sdc.meridian.data-table",
   "parent_uuid": "a3706de4-8d2b-4b99-b2a0-a0aed65844d8",
   "slot": "parts",
   "inputs": {
    "caption": "Terminal 1, after security",
    "caption_hidden": true,
    "body": "<thead><tr><th scope=\"col\">Venue</th><th scope=\"col\">Open</th><th scope=\"col\">What it serves</th></tr></thead>\n<tbody>\n<tr><th scope=\"row\">Skyline Kitchen</th><td>04:30–21:00</td><td>Full breakfasts until 11:30, then hot plates and salads. Table service with views of the runway.</td></tr>\n<tr><th scope=\"row\">Runway Noodle Bar</th><td>10:00–21:30</td><td>Ramen, rice bowls and dumplings, cooked to order in about 8 minutes.</td></tr>\n</tbody>"
   }
  },
