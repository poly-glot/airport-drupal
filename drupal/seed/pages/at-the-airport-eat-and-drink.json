    "id": "families-title",
    "size": "sm"
   }
  },
  {
   "uuid": "acba7785-14a1-4566-8c3f-225b07a020f8",
   "component_id": "sdc.meridian.prose",
   "parent_uuid": "88322d25-9230-4bc0-891b-66e9c2fec9b0",
   "slot": "parts",
   "inputs": {
    "body": "<p>The Wayfarer and Skyline Kitchen have high chairs and children's menus. Every venue will warm baby milk or food if you ask.</p>"
