   }
  },
  {
   "uuid": "73d7e6a8-77c2-479a-be8b-bd83adcbc6db",
   "component_id": "sdc.meridian.heading",
   "parent_uuid": "147437ca-921b-410b-8c23-ce62f24173ed",
   "slot": "parts",
   "inputs": {
    "text": "Food for the flight",
    "level": "h2",
    "id": "food-for-the-flight-title",
    "size": "sm"
   }
  },
  {
   "uuid": "565e9143-faf9-4ba6-aded-1e11908ef0b6",
   "component_id": "sdc.meridian.prose",
   "parent_uuid": "147437ca-921b-410b-8c23-ce62f24173ed",
   "slot": "parts",
   "inputs": {
    "body": "<p>You can take food bought after security on board. Little Orchard and Platform Seven Bakery pack everything to travel. Drinks bought after security can go on board too, but check with your airline whether you can drink them during the flight.</p>"
   }
  },
  {
