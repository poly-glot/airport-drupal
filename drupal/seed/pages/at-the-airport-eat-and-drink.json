   }
  },
  {
   "uuid": "3587c0fe-2220-441c-a32c-4d63032bdb0a",
   "component_id": "sdc.meridian.data-table",
   "parent_uuid": "ddc08b8d-5b8d-49df-9587-56927ccf3f27",
   "slot": "parts",
   "inputs": {
    "caption": "Terminal 2, after security",
    "caption_hidden": true,
    "body": "<thead><tr><th scope=\"col\">Venue</th><th scope=\"col\">Open</th><th scope=\"col\">What it serves</th></tr></thead>\n<tbody>\n<tr><th scope=\"row\">The Wayfarer</th><td>04:30–last departure</td><td>Bar and grill with a full menu all day and a children's menu.</td></tr>\n<tr><th scope=\"row\">Little Orchard</th><td>04:30–20:30</td><td>Salads, wraps, fruit pots and juices to take on board.</td></tr>\n</tbody>"
   }
