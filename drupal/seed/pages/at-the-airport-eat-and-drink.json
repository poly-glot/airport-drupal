   "component_id": "sdc.meridian.heading",
   "parent_uuid": "c3a5bfca-eda7-4af5-92c0-40d82d7aec7f",
   "slot": "parts",
   "inputs": {
    "text": "Alcohol",
    "level": "h2",
    "id": "alcohol-title",
    "size": "sm"
   }
  },
  {
   "uuid": "7b9bff66-1226-4732-8699-063be22c03e8",
   "component_id": "sdc.meridian.prose",
   "parent_uuid": "c3a5bfca-eda7-4af5-92c0-40d82d7aec7f",
   "slot": "parts",
   "inputs": {
    "body": "<p>Bars serve alcohol from 04:30. Staff will not serve anyone who appears drunk, and airlines can refuse to fly passengers who are. You cannot drink alcohol bought in duty free on board.</p>"
   }
  },
