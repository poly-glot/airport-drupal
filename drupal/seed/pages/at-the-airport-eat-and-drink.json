   "parent_uuid": "c86b260a-73cb-4b1a-8a6b-c15331116e41",
   "slot": "parts",
   "inputs": {
    "text": "Water",
    "level": "h2",
    "id": "water-title",
    "size": "sm"
   }
  },
  {
   "uuid": "b4dea0ef-915c-4414-bc9f-2171992500c8",
   "component_id": "sdc.meridian.prose",
   "parent_uuid": "c86b260a-73cb-4b1a-8a6b-c15331116e41",
   "slot": "parts",
   "inputs": {
    "body": "<p>Free water refill points are after security, near every toilet block in both terminals. Bring an empty bottle through security and fill it up on the other side.</p>"
   }
  },
