   }
  },
  {
   "uuid": "d20dc30f-dc87-43e2-afa8-241b5cc98a86",
   "component_id": "sdc.meridian.paragraph",
   "parent_uuid": "0e5da91e-988b-4a5e-8c2b-2bff0973d19a",
   "slot": "parts",
   "inputs": {
    "body": "<time datetime=\"2026-08-27\">27 August 2026</time>",
    "variant": "card-text"
   }
  },
  {
   "uuid": "58405b37-e82a-47bb-9a58-0d34bd45e13a",
   "component_id": "sdc.meridian.heading",
   "parent_uuid": "0e5da91e-988b-4a5e-8c2b-2bff0973d19a",
   "slot": "parts",
   "inputs": {
    "text": "Kestrel adds Innsbruck for the winter season",
    "level": "h3",
    "size": "card"
   }
  },
  {
   "uuid": "8f309256-8c90-4a20-ad44-42a36d244f47",
   "component_id": "sdc.meridian.paragraph",
   "parent_uuid": "0e5da91e-988b-4a5e-8c2b-2bff0973d19a",
   "slot": "parts",
   "inputs": {
    "body": "Kestrel will fly twice a week from Terminal 2 to Innsbruck between 19 December 2026 and 3 April 2027. The route joins its year-round flights to Geneva, Salzburg and Zurich, and is timed for Saturday and Wednesday ski changeovers.",
    "variant": "card-text"
   }
  },
  {
   "uuid": "f7c04f62-40c1-40ac-aa5a-5aa3dd0cbca0",
   "component_id": "sdc.meridian.section",
   "inputs": {
    "anchor": "media-enquiries",
    "tone": "light",
    "tag": "section",
    "labelled_by": "media-enquiries-title",
    "heading_level": "h2"
   }
  },
  {
   "uuid": "13027d60-d7d4-47c3-ba86-ce7a3aefbbde",
   "component_id": "sdc.meridian.prose",
   "parent_uuid": "f7c04f62-40c1-40ac-aa5a-5aa3dd0cbca0",
   "slot": "parts",
   "inputs": {
    "body": "<h2 id=\"media-enquiries-title\">Media enquiries</h2>\n<p>Our press office answers media enquiries every day.</p>\n<ul><li>Phone: <a href=\"tel:+441214960123\">0121 496 0123</a>, and ask for the press office</li><li>Email: <a href=\"mailto:hello@meridianairport.example\">hello@meridianairport.example</a>, with \"Media\" in the subject line</li></ul>\n<p>Passengers with questions about a flight should contact their airline. For other passenger questions, go to Help and contact.</p>\n<p><a href=\"/help\">Help and contact</a></p>"
   }
  },
  {
   "uuid": "562cee98-d224-4f3f-a302-7bcb5292d513",
   "component_id": "sdc.meridian.section",
   "inputs": {
    "anchor": "filming-and-photography",
    "tone": "light",
    "tag": "section",
    "labelled_by": "filming-and-photography-title",
    "heading_level": "h2"
   }
  },
  {
   "uuid": "467dfcd2-7639-4e30-ab5e-4d0b1e985d53",
   "component_id": "sdc.meridian.prose",
   "parent_uuid": "562cee98-d224-4f3f-a302-7bcb5292d513",
   "slot": "parts",
   "inputs": {
    "body": "<h2 id=\"filming-and-photography-title\">Filming and photography</h2>\n<p>You need our permission to film or take photographs for publication anywhere at the airport, including the car parks. Send us the date, location, crew size and purpose at least 5 working days ahead. Filming airside needs an escort and security passes for everyone in the crew.</p>"
   }
  },
  {
   "uuid": "26c411a8-7588-40a6-a9bd-cc435140b503",
