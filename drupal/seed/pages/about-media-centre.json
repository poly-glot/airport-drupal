   "component_id": "sdc.meridian.heading",
   "parent_uuid": "58ef8524-c498-4380-a061-30d1a5eb0a98",
   "slot": "parts",
   "inputs": {
    "text": "New security scanners open in Terminal 1",
    "level": "h3",
    "size": "card"
   }
  },
  {
   "uuid": "226fc85f-bcee-4a07-a50c-8386dce96f9f",
   "component_id": "sdc.meridian.paragraph",
   "parent_uuid": "58ef8524-c498-4380-a061-30d1a5eb0a98",
   "slot": "parts",
   "inputs": {
    "body": "All six security lanes in Terminal 1 now use new scanners. Passengers can leave liquids in containers up to 2 litres, and laptops, in their bags. Average waits in the first week fell from 14 minutes to 8. Terminal 2 is next, with new lanes due by spring 2027.",
    "variant": "card-text"
   }
  },
  {
