   }
  },
  {
   "uuid": "27e62a09-eaf0-4de0-9e2d-00937aa9a222",
   "component_id": "sdc.meridian.paragraph",
   "parent_uuid": "a75ae8f2-326c-4b08-affa-b19c9c068c17",
   "slot": "parts",
   "inputs": {
    "body": "<time datetime=\"2026-09-15\">15 September 2026</time>",
    "variant": "card-text"
   }
  },
  {
   "uuid": "8516a8fb-cf71-49fe-a572-30528cc33d6e",
   "component_id": "sdc.meridian.heading",
   "parent_uuid": "a75ae8f2-326c-4b08-affa-b19c9c068c17",
   "slot": "parts",
   "inputs": {
    "text": "120 electric vehicle charging bays open at Mid-Stay",
    "level": "h3",
    "size": "card"
   }
  },
  {
   "uuid": "e7cc5fbb-2001-4b85-b704-2c40c7aa99c6",
   "component_id": "sdc.meridian.paragraph",
   "parent_uuid": "a75ae8f2-326c-4b08-affa-b19c9c068c17",
   "slot": "parts",
   "inputs": {
    "body": "The Mid-Stay car park now has 120 charging bays, bringing the airport total to 166. Drivers can book a charging bay with their parking and pay at the charger. Power comes from the airport's renewable electricity supply.",
    "variant": "card-text"
   }
  },
  {
   "uuid": "0e5da91e-988b-4a5e-8c2b-2bff0973d19a",
   "component_id": "sdc.meridian.card",
   "parent_uuid": "09a6072f-5184-41f7-bf48-7c57f2ad2d43",
