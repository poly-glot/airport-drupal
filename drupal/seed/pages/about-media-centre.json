  },
  {
   "uuid": "05731a57-419d-4dae-af17-56cfb690a7b7",
   "component_id": "sdc.meridian.prose",
   "parent_uuid": "26c411a8-7588-40a6-a9bd-cc435140b503",
   "slot": "parts",
   "inputs": {
    "body": "<h2 id=\"facts-for-journalists-title\">Facts for journalists</h2>\n<ul><li>Meridian Airport opened in 1971. Terminal 2 opened in 2009.</li><li>Passengers in 2025: 6.4 million.</li><li>Airlines: Meridian Air, Nordvik, Azur Express and Kestrel.</li><li>Destinations: 20.</li><li>Runway: 09/27, one runway.</li><li>People employed across the airport: around 3,100.</li><li>Owner and operator: Meridian Airport Ltd.</li></ul>"
   }
  }
