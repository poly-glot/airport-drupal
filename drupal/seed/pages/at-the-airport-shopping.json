    "caption_hidden": true,
    "body": "<thead><tr><th scope=\"col\">Venue</th><th scope=\"col\">Open</th><th scope=\"col\">What it serves</th></tr></thead>\n<tbody>\n<tr><th scope=\"row\">Meridian Duty Free</th><td>04:00–last departure</td><td>The full duty free range. Reserve and collect available.</td></tr>\n<tr><th scope=\"row\">Pages and Passports</th><td>04:30–last departure</td><td>Books, magazines, sweets and puzzle books for the flight.</td></tr>\n<tr><th scope=\"row\">Kit and Caboodle</th><td>06:00–20:00</td><td>Toys, colouring sets and small games for children.</td></tr>\n</tbody>"
