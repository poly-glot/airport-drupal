   "parent_uuid": "4904edb2-add0-413f-94c6-25f4875fa485",
   "slot": "parts",
   "inputs": {
    "body": "<p>Liquids bought after security can go in your hand luggage, whatever the size. If you have a connecting flight, keep them in the sealed bag with the receipt inside, or they may be taken at your next security check.</p>"
   }
