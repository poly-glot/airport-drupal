   "parent_uuid": "c2e0c7e1-c791-4463-af15-db935a363a28",
   "slot": "parts",
   "inputs": {
    "body": "<p>Keep your receipt. You can return unopened items within 28 days by post. Call 0121 496 0123 or email hello@meridianairport.example and we will send you a returns label.</p>"
