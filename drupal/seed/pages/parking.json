   "component_id": "sdc.meridian.prose",
   "parent_uuid": "655b34e9-e403-4394-b376-43f9686a0ac6",
   "slot": "parts",
   "inputs": {
    "body": "<ul>\n<li>Your number plate is your ticket. Cameras read it on the way in and out.</li>\n<li>All three car parks are step-free to check-in, with lifts in each one.</li>\n<li>Shuttle buses have a ramp, space for a wheelchair and racks for big cases.</li>\n<li>If your return flight is delayed, the first 2 hours past your booked time are free.</li>\n<li>Height limit in P2 Long-stay is 2.1 metres. Vans and roof boxes should use Mid-Stay.</li>\n</ul>"
   }
