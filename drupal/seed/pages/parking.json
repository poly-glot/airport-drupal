   "slot": "parts",
   "inputs": {
    "body": "Use the free 10-minute zone at the Mid-Stay car park, for dropping off or picking up. Your passenger takes the shuttle bus to or from either terminal, which runs every 10 minutes, day and night.",
    "variant": "card-text"
   }
  },
