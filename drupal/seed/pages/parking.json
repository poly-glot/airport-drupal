   "slot": "parts",
   "inputs": {
    "body": "Drop-off zones are right outside both terminals. They cost £3 for up to 10 minutes, paid by card or phone at the exit barrier. You cannot leave your car unattended.",
    "variant": "card-text"
   }
  },
  {
