        "format:check": "prettier --check .",
        "lint:css": "stylelint \"**/*.css\""
    },
    "dependencies": {
        "@drupal-canvas/headless": "^0.11.0",
        "@drupal-canvas/headless-next": "^0.8.0",
        "@drupal-canvas/headless-react": "^0.5.1",
        "drupal-canvas": "^0.7.1",
        "next": "^16.2.12",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "swr": "^2.5.1"
    },
    "overrides": {
        "postcss": "^8.5.10",
        "sharp": "^0.35.3"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@drupal-canvas/cli": "^0.26.2",
        "@drupal-canvas/eslint-config": "^0.10.1",
        "@drupal-canvas/workbench": "^0.13.2",
        "@playwright/test": "^1.64.1",
        "@types/node": "^22.10.2",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "eslint": "^9.39.4",
        "eslint-config-next": "^16.2.12",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.10",
        "stylelint": "^17.16.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-order": "^8.1.2",
        "typescript": "^5.9.3"
    },
    "allowScripts": {
        "esbuild@0.25.12": true,
        "esbuild@0.28.1": true,
        "fsevents@2.3.3": true,
        "unrs-resolver@1.12.2": true
    }
