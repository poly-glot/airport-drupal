{
    "name": "next",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=22.19.0 <23 || >=24.5.0"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "workbench": "canvas-workbench",
        "lint": "eslint .",
        "type-check": "tsc --noEmit",
        "check": "npm run lint && npm run lint:css && npm run format:check && npm run type-check",
